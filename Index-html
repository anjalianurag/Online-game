<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mobile Game Hub</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', sans-serif;
    }
    body {
      background-color: #121212;
      color: #fff;
      line-height: 1.6;
    }
    header {
      background: #1f1f1f;
      padding: 1rem;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    }
    header h1 {
      font-size: 2rem;
      color: #00ffcc;
    }
    .container {
      padding: 2rem;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }
    .card {
      background: #1e1e1e;
      border-radius: 16px;
      padding: 1rem;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
      transition: transform 0.3s ease;
    }
    .card:hover {
      transform: translateY(-5px);
    }
    .card img {
      width: 100%;
      border-radius: 12px;
      margin-bottom: 1rem;
    }
    .card h3 {
      margin-bottom: 0.5rem;
      font-size: 1.2rem;
    }
    .card p {
      font-size: 0.9rem;
      color: #bbb;
      margin-bottom: 1rem;
    }
    .download-btn {
      display: inline-block;
      padding: 0.5rem 1rem;
      background: #00ffcc;
      color: #000;
      border: none;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
      transition: background 0.3s;
    }
    .download-btn:hover {
      background: #00e6b2;
    }
    footer {
      text-align: center;
      padding: 1rem;
      font-size: 0.9rem;
      color: #666;
    }
  </style>
</head>
<body>
  <header>
    <h1>Mobile Game Hub</h1>
  </header>
  <main class="container">
    <div class="card">
      <img src="https://via.placeholder.com/300x150.png?text=Game+1" alt="Game 1">
      <h3>Speed Racer</h3>
      <p>Race at lightning speed through traffic-packed highways. Feel the adrenaline!</p>
      <a href="#" class="download-btn">Download</a>
    </div>
    <div class="card">
      <img src="https://via.placeholder.com/300x150.png?text=Game+2" alt="Game 2">
      <h3>Zombie Blaster</h3>
      <p>Survive waves of the undead with your elite weapons arsenal.</p>
      <a href="#" class="download-btn">Download</a>
    </div>
    <div class="card">
      <img src="https://via.placeholder.com/300x150.png?text=Game+3" alt="Game 3">
      <h3>Puzzle Master</h3>
      <p>Challenge your mind with hundreds of unique logic puzzles and riddles.</p>
      <a href="#" class="download-btn">Download</a>
    </div>
  </main>
  <footer>
    &copy; 2025 Mobile Game Hub. All rights reserved.
  </footer>
</body>
</html>


